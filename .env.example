# ---------------------------------------------------------------------------
# Frontend (browser-safe) — used by the React app. In Vercel, add these under
# Project Settings → Environment Variables. Find them in your Supabase project
# under Project Settings → API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Server-only (NEVER expose to the browser) — used by the /api/cron/sync
# serverless function that pulls live results from the FPL API and writes them
# into Supabase. The service-role key bypasses row-level security, so keep it
# secret and set it only in Vercel's Environment Variables (not prefixed VITE_).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: if set, /api/cron/sync requires this token (Vercel Cron sends it
# automatically as a Bearer header). Lets you keep the endpoint from being
# triggered by strangers. Leave unset to allow the in-app "Refresh" button.
CRON_SECRET=
